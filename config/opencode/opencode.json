  "plugin": [
    "/Users/mocull/.tmux/plugins/tmux-ai-usage/plugins/opencode.js"
  ],
  "provider": {
    "headroom": {
      "models": {
        "gpt-4.1": {
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "name": "GPT-4.1"
        },
        "gpt-4o": {
          "limit": {
            "context": 128000,
            "output": 16384
          },
          "name": "GPT-4o"
        }
      },
      "name": "Headroom Proxy",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    },
    "ollama-remote": {
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen 3 Coder 30B"
        },
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B"
        }
      },
      "name": "Ollama Remote",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.1.11:11434/v1"
      }
    },
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-flash-0731": {
          "options": {
            "provider": {
              "allow_fallbacks": true,
              "data_collection": "deny",
              "zdr": true
            }
          }
        },
        "moonshotai/kimi-k3": {
          "options": {
            "provider": {
              "allow_fallbacks": true,
              "data_collection": "deny",
              "zdr": true
            }
          },
          "variants": {
            "max": {
              "reasoning": {
                "effort": "max"
              }
            }
          }
        },
        "z-ai/glm-5.3": {
          "options": {
            "provider": {
              "allow_fallbacks": true,
              "data_collection": "deny",
              "zdr": true
            }
          },
          "variants": {
            "max": {
              "reasoning": {
                "effort": "max"
              }
            }
          }
        },
        "z-ai/glm-5.3-flash": {
          "options": {
            "provider": {
              "allow_fallbacks": true,
              "data_collection": "deny",
              "zdr": true
            }
          }
        }
      }
    },
    "venice": {
      "models": {
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash"
        }
      },
      "name": "Venice AI",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:VENICE_API_KEY}",
        "baseURL": "https://api.venice.ai/api/v1"
      }
    }
