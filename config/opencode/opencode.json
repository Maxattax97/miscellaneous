{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "model": "venice/z-ai-glm-5-3-flash",
      "variant": "high"
    },
    "explore": {
      "model": "venice/deepseek-v4-flash-0731"
    },
    "plan": {
      "model": "venice/z-ai-glm-5-3-flash",
      "variant": "high"
    },
    "scout": {
      "description": "Read-only agent for external documentation, dependency research, and upstream source investigation",
      "mode": "subagent",
      "model": "venice/deepseek-v4-flash-0731",
      "permission": {
        "*": "deny",
        "bash": {
          "*": "allow",
          "git commit": "deny",
          "git commit *": "deny"
        },
        "external_directory": "ask",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "read": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      },
      "prompt": "Research external documentation, dependencies, and upstream source without modifying the user's workspace. Prefer primary sources, cross-reference findings against local code when relevant, and report precise evidence. Do not create or edit project files and do not delegate further."
    }
  },
  "default_agent": "build",
  "mcp": {
    "freecad": {
      "command": [
        "uvx",
        "freecad-mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "headroom": {
      "command": [
        "/home/max/.local/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true,
      "type": "local"
    },
    "playwright": {
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "venice/z-ai-glm-5-3-flash",
  "permission": {
