{
  "hooks": {
    "Interrupt": [
      {
        "hooks": [
          {
            "command": "if [ -x \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" ]; then \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" --agent codex end; fi",
            "statusMessage": "Updating tmux agent activity",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "if [ -x \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" ]; then \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" --agent codex end; fi",
            "statusMessage": "Updating tmux agent activity",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "if [ -x \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" ]; then \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" --agent codex begin; fi",
            "statusMessage": "Updating tmux agent activity",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/claude-mem\" hook codex observation",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "if [ -x \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" ]; then \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" --agent codex begin; fi",
            "statusMessage": "Updating tmux agent activity",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "matcher": "^Bash$|^mcp__.+__(read|view|cat)(_file|_files)?$|^Grep$|^Glob$|^memory_search$|^memory$|^mcp__.+__memory_search$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/claude-mem\" hook codex file-context",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "if [ -x \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" ]; then \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" --agent codex end; fi",
            "statusMessage": "Updating tmux agent activity",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "if [ -f \"$HOME/.codex/herdr-agent-state.sh\" ]; then bash \"$HOME/.codex/herdr-agent-state.sh\" session; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gh-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "chrome-devtools-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "lavish-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/claude-mem\" hook codex context",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "if [ -x \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" ]; then \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" --agent codex end; fi",
            "statusMessage": "Updating tmux agent activity",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/claude-mem\" hook codex summarize",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "if [ -x \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" ]; then \"${AI_USAGE_HOME:-$HOME/.tmux/plugins/tmux-ai-usage}/scripts/ai-activity\" --agent codex begin; fi",
            "statusMessage": "Updating tmux agent activity",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/claude-mem\" hook codex session-init",
            "timeout": 20
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/claude-mem\" hook codex post-compact",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/claude-mem\" hook codex subagent-context",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
