FROM fedora:rawhide

# This is a very up-to-date image, so we aren't going to lock package versions.
# hadolint ignore=DL3041
RUN dnf install -y \
	curl \
	git \
	sudo \
	coreutils \
	util-linux && \
	dnf clean all

RUN useradd -m max && \
	echo "max ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
ENV USER=max
ENV SHELL=/bin/zsh

RUN mkdir -p /home/max/src/miscellaneous && \
	chown -R max:max /home/max/src
COPY --chown=max . /home/max/src/miscellaneous/

WORKDIR /home/max/src/miscellaneous
RUN /bin/bash -o pipefail -c "awk 'BEGIN { print \"y\"; for (i = 0; i < 200; i++) print \"n\" }' | runuser -u max -- env AUTOMATED=1 /home/max/src/miscellaneous/install.sh" && \
	dnf clean all

USER max
WORKDIR /home/max
ENTRYPOINT ["/bin/zsh"]
HEALTHCHECK NONE
