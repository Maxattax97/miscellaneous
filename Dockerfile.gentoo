FROM gentoo/stage3:amd64-openrc
ARG REPO_URL
ARG COMMIT_SHA

# Bootstrap Portage before enabling the binary-package configuration below.
COPY --chown=root:root config/portage/make.conf /etc/portage/make.conf
COPY --chown=root:root config/portage/repos.conf/ /etc/portage/repos.conf/

# Update the release key and install the binpkg trust bootstrap before enabling
# the CI binhost. This also works if a future stage3 image omits getuto.
# This is a rolling image, so package versions are intentionally unlocked.
# hadolint ignore=DL3041
RUN curl -o /usr/share/openpgp-keys/gentoo-release.asc https://qa-reports.gentoo.org/output/service-keys.gpg && \
	emerge --sync && \
	CFLAGS="-O2 -pipe" \
	CXXFLAGS="-O2 -pipe" \
	FCFLAGS="-O2 -pipe" \
	FFLAGS="-O2 -pipe" \
	FEATURES="-ccache -ipc-sandbox -mount-sandbox -network-sandbox -pid-sandbox" \
	emerge --tree --noreplace app-portage/getuto && \
	getuto

COPY --chown=root:root config/portage/ci/make.conf /etc/portage/make.conf
COPY --chown=root:root config/portage/ci/binrepos.conf/ /etc/portage/binrepos.conf/

# Update the system and install the packages under test, preferring signed
# official binpkgs and compiling from source only when no compatible binpkg exists.
# hadolint ignore=DL3041
RUN \
	eselect profile set default/linux/amd64/23.0 && \
	emerge --tree --update --deep --newuse @world && \
	emerge --depclean && \
	emerge --tree --noreplace \
	net-misc/curl \
	dev-vcs/git \
	app-admin/sudo \
	sys-apps/coreutils && \
	emerge --depclean && \
	useradd -m max && \
	echo "max ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
# The installer relies on the max account name for user-specific setup.
# hadolint ignore=DL3066
USER max
ENV USER=max

# NOTE: This is dangerous because it will include decrypted secrets in the image!
#RUN mkdir -p /home/max/src/miscellaneous
#COPY --chown=max . /home/max/src/miscellaneous/

RUN mkdir -p /home/max/src
WORKDIR /home/max/src
RUN git clone "$REPO_URL" miscellaneous

WORKDIR /home/max/src/miscellaneous
RUN git checkout --detach "$COMMIT_SHA" && \
	/bin/sh -c "yes n | AUTOMATED=1 /home/max/src/miscellaneous/install.sh && \
	sudo emerge --verbose --depclean"

WORKDIR /home/max
ENTRYPOINT ["/bin/zsh"]
HEALTHCHECK NONE
