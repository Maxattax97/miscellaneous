-- Neovim and Awesome expose these names from their host applications.
globals = {
    "vim",
    "Snacks",
    "awesome",
    "client",
    "mouse",
    "screen",
    "tag",
    "root",
    "terminal",
    "editor",
    "editor_cmd",
    "modkey",
    "myawesomemenu",
    "mymainmenu",
}

-- The WeeChat emoji table is generated data, not application code.
exclude_files = {
    "config/weechat/lua/emoji.lua",
}
